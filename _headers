# Cloudflare Pages / Workers static assets fejlécek.
# A fájlnevek nem tartalmaznak tartalom-hasht, ezért nincs egyéves „immutable”:
# a képek egy hétig, a kód egy napig, az adat egy óráig él a gyorsítótárban.

/assets/img/*
  Cache-Control: public, max-age=604800

/assets/css/*
  Cache-Control: public, max-age=86400

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=86400

/assets/dok/*
  Cache-Control: public, max-age=604800

/data/*
  Cache-Control: public, max-age=3600

/*
  Cache-Control: public, max-age=600
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; frame-src https://www.youtube-nocookie.com https://www.google.com; connect-src 'self'
